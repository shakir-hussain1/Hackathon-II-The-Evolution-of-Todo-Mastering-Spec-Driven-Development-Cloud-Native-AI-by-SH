# Phase IV - Kubernetes Deployment Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Backend Configuration
JWT_SECRET=your-jwt-secret-key-here
OPENAI_API_KEY=your-openai-api-key-here
DATABASE_URL=sqlite:///./todo.db

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://backend-service:8000

# Minikube Configuration
MINIKUBE_DRIVER=docker
MINIKUBE_MEMORY=6144
MINIKUBE_CPUS=2

# Docker Image Configuration
FRONTEND_IMAGE=todo-frontend:v1.0.0
BACKEND_IMAGE=todo-backend:v1.0.0

# Helm Configuration
HELM_RELEASE_NAME=todo-app
HELM_NAMESPACE=default

# Optional: Docker Registry (leave empty for local Minikube)
DOCKER_REGISTRY=
