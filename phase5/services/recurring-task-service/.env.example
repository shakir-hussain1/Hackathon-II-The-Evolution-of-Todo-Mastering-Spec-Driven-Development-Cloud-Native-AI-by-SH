# Recurring Task Service Environment Variables
# Database Configuration
DATABASE_URL=postgresql+asyncpg://phase5_user:phase5_pass@postgres:5432/phase5_db

# Dapr Configuration
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_PORT=8002
DAPR_APP_ID=recurring-task-service

# Dapr Component Names
DAPR_PUBSUB_NAME=pubsub-kafka
DAPR_SECRET_STORE_NAME=secretstore-kubernetes
DAPR_CRON_BINDING_NAME=cron-recurring-tasks

# Kafka Topics
TOPIC_TASK_EVENTS=task-events

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Service Configuration
SERVICE_NAME=recurring-task-service
SERVICE_VERSION=5.0.0
ENVIRONMENT=development

# Cron Settings
CRON_CHECK_INTERVAL_MINUTES=5
