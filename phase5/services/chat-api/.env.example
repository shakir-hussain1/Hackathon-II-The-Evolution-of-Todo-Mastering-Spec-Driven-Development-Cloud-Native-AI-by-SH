# Chat API Service Environment Variables
# Database Configuration
DATABASE_URL=postgresql+asyncpg://phase5_user:phase5_pass@postgres:5432/phase5_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# OpenAI Configuration (from Phase III)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Dapr Configuration
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_PORT=8000
DAPR_APP_ID=chat-api

# Dapr Component Names
DAPR_PUBSUB_NAME=pubsub-kafka
DAPR_STATE_STORE_NAME=statestore-postgresql
DAPR_SECRET_STORE_NAME=secretstore-kubernetes

# Kafka Topics
TOPIC_TASK_EVENTS=task-events
TOPIC_REMINDERS=reminders
TOPIC_TASK_UPDATES=task-updates

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Service Configuration
SERVICE_NAME=chat-api
SERVICE_VERSION=5.0.0
ENVIRONMENT=development
