# WebSocket Sync Service Environment Variables
# Dapr Configuration
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_PORT=8080
DAPR_APP_ID=websocket-sync-service

# Dapr Component Names
DAPR_PUBSUB_NAME=pubsub-kafka
DAPR_STATE_STORE_NAME=statestore-postgresql
DAPR_SECRET_STORE_NAME=secretstore-kubernetes

# Kafka Topics
TOPIC_TASK_UPDATES=task-updates

# Redis Configuration (for connection state)
REDIS_URL=redis://redis:6379/1

# JWT Configuration (for WebSocket auth)
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Service Configuration
SERVICE_NAME=websocket-sync-service
SERVICE_VERSION=5.0.0
ENVIRONMENT=development

# WebSocket Settings
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS_PER_USER=5
