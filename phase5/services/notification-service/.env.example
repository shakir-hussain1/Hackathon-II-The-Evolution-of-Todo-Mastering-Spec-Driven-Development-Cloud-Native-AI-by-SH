# Notification Service Environment Variables
# Database Configuration
DATABASE_URL=postgresql+asyncpg://phase5_user:phase5_pass@postgres:5432/phase5_db

# Dapr Configuration
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_PORT=8001
DAPR_APP_ID=notification-service

# Dapr Component Names
DAPR_PUBSUB_NAME=pubsub-kafka
DAPR_SECRET_STORE_NAME=secretstore-kubernetes

# Kafka Topics
TOPIC_REMINDERS=reminders
TOPIC_TASK_EVENTS=task-events

# SMTP Configuration (optional - for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@phase5.local
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM_EMAIL=noreply@phase5.local
SMTP_USE_TLS=true

# Redis Configuration (for event deduplication)
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Service Configuration
SERVICE_NAME=notification-service
SERVICE_VERSION=5.0.0
ENVIRONMENT=development
