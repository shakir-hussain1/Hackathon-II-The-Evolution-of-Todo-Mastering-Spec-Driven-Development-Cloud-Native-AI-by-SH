# Audit Service Environment Variables
# Database Configuration
DATABASE_URL=postgresql+asyncpg://phase5_user:phase5_pass@postgres:5432/phase5_db

# Dapr Configuration
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_PORT=8003
DAPR_APP_ID=audit-service

# Dapr Component Names
DAPR_PUBSUB_NAME=pubsub-kafka
DAPR_SECRET_STORE_NAME=secretstore-kubernetes

# Kafka Topics (subscribe to ALL)
TOPIC_TASK_EVENTS=task-events
TOPIC_REMINDERS=reminders
TOPIC_TASK_UPDATES=task-updates

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Service Configuration
SERVICE_NAME=audit-service
SERVICE_VERSION=5.0.0
ENVIRONMENT=development

# Audit Log Retention (days)
AUDIT_RETENTION_DAYS=90
