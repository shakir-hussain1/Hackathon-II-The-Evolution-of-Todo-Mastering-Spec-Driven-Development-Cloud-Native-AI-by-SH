# Database
# For local development, use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./todo.db
# For production, use PostgreSQL (Neon, Supabase, etc.):
DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database_name?sslmode=require

# OpenAI
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Authentication
# Generate a secure random secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secure-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
